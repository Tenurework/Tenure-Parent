{
  "name": "tenure-parent",
  "version": "0.0.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "npm run dev --workspace apps/web",
    "build": "npm run build --workspace apps/web",
    "start": "npm run start --workspace apps/web",
    "lint": "npm run lint --workspace apps/web",
    "type-check": "npm run type-check --workspace apps/web",
    "test": "npm run test --workspace apps/web",
    "test:isolation": "npm run test:isolation --workspace apps/web",
    "e2e": "npm run e2e --workspace apps/web",
    "db:migrate": "npm exec --workspace apps/web -- prisma migrate deploy",
    "db:seed": "node apps/web/scripts/seed.mjs"
  }
}
