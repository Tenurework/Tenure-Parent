# Monorepo root .gitignore.
#
# The app-level entries below deliberately have NO leading slash. A leading
# slash anchors a pattern to the directory holding the .gitignore, so a leading-
# slash "node_modules" here would no longer match apps/web/node_modules and the first
# `git add -A` after the move would stage the entire installed dependency tree.
# The terraform entries at the bottom are deliberately UNANCHORED, for the same
# reason: there are three stacks now (terraform, studio, oidc) and a fourth will
# not remember to add itself. A path-prefixed rule covered only the first, and a
# 674 MB provider binary from a local `terraform init` in the second was staged
# by `git add -A` and rejected at the remote.

# dependencies
node_modules/
.pnp/
.pnp.js

# testing
coverage/
test-results/
playwright-report/

# next.js
.next/
out/

# production
build/

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# local env files
.env
.env*.local

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# prisma
**/prisma/*.db

# local e2e/dev server log
.server.log

# ad-hoc local debugging scripts (smoke.local.mjs, probe.local.mjs, ...)
*.local.mjs

# terraform — provider plugins (700MB+) and local state, from running
# `terraform validate` outside CI. The lock file is ignored on purpose too:
# CI pins terraform 1.9 and resolves providers itself, so a lock written by a
# newer local CLI would silently change what production deploys.
.terraform/
.terraform.lock.hcl
*.tfstate
*.tfstate.*
*.tfplan

# Real roster: 172 named students and advisors with university addresses.
# Never commit. scripts/roster-source.mjs falls through to the synthetic
# fixture when this is absent, so removing it breaks nothing.
apps/web/scripts/roster-data.mjs
