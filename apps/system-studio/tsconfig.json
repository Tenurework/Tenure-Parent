{
  "compilerOptions": {
    "target": "ES2017",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": [
        "./src/*"
      ],
      "@tenure/audit": [
        "../../packages/audit/src/index.ts"
      ],
      "@tenure/configuration": [
        "../../packages/configuration/src/index.ts"
      ],
      "@tenure/blueprints": [
        "../../blueprints/index.ts"
      ],
      "@tenure/authorization": [
        "../../packages/authorization/src/index.ts"
      ],
      "@tenure/contracts": [
        "../../packages/contracts/src/index.ts"
      ],
      "@tenure/organization-model": [
        "../../packages/organization-model/src/index.ts"
      ],
      "@tenure/module-runtime": [
        "../../packages/module-runtime/src/index.ts"
      ],
      "@tenure/modules": [
        "../../modules/index.ts"
      ],
      "@tenure/releases": [
        "../../packages/releases/src/index.ts"
      ],
      "@tenure/payments": [
        "../../packages/payments/src/index.ts"
      ],
      "@tenure/payments/gateway": [
        "../../packages/payments/src/gateway.ts"
      ],
      "@tenure/platform-config": [
        "../../packages/platform-config/src/index.ts"
      ],
      "@tenure/provisioning": [
        "../../packages/provisioning/src/index.ts"
      ],
      "@tenure/finops": [
        "../../packages/finops/src/index.ts"
      ]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    "../../blueprints/**/*.ts",
    "../../modules/**/*.ts",
    "../../packages/*/src/**/*.ts",
    ".next/types/**/*.ts",
    "next-env.d.ts",
    ".next-console-index/types/**/*.ts"
  ],
  "exclude": [
    "node_modules"
  ]
}
