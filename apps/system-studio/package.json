{
  "name": "@tenure/system-studio",
  "version": "0.1.0",
  "private": true,
  "//": "The Tenure-internal console. Separate from apps/web because it shows EVERY tenant's configuration, and a host that serves one customer must not also serve the console that configures all of them \u2014 see PD-007.",
  "//dependencies": "@tenure/contracts and @tenure/finops were in next.config.ts's transpilePackages and NOT declared here. That resolves under npm workspaces and breaks anywhere else, and `npm ci` in a workspace-less build would not install them at all. contracts supplies parseCommand/replayable/IdempotencyRecord/MAX_PAGE to src/lib/command-gate.ts and src/lib/api/envelope.ts; finops supplies approvalFor to the same gate.",
  "scripts": {
    "dev": "next dev --port 3100",
    "build": "next build",
    "start": "next start --port 3100",
    "lint": "next lint",
    "type-check": "tsc --noEmit",
    "e2e": "playwright test"
  },
  "dependencies": {
