# Copy to .env for local development. .env is gitignored — never commit real secrets.
# The contract these values must satisfy is enforced at boot by src/lib/env.ts.

# ── Required ──────────────────────────────────────────────────────────────────

# Local Postgres. The pilot uses a manual cluster on 5433 so it does not collide
# with a default 5432 install:
#   pg_ctl -D <datadir> -l <datadir>/server.log -o "-p 5433" start
DATABASE_URL=postgresql://tenure:tenure@localhost:5433/tenure

# Signs session cookies. Production requires 32+ characters and rejects the
# known placeholders; generate one with: openssl rand -base64 48
AUTH_SECRET=replace-me-with-at-least-32-characters-of-random

NEXTAUTH_URL=http://localhost:3000
AUTH_TRUST_HOST=true

# ── Sign-in ───────────────────────────────────────────────────────────────────

# Passwordless sign-in as any seeded demo account. Development affordance only:
# the seeded set includes an OSE_DIRECTOR, so anyone who can reach the site can
# take the highest role in the system.
AUTH_DEV_LOGIN=true

# `next start` (which the Playwright suite runs) sets NODE_ENV=production, so
# the production rules apply even locally. This states the pilot posture
# explicitly rather than letting it be inherited silently.
ALLOW_DEV_LOGIN_IN_PRODUCTION=true

# Interim shared secret in front of passwordless sign-in, until Okta is live.
# Required (min 12 chars) whenever dev login is on in production mode — which
# includes `next start`, so the e2e suite needs it too. In AWS this is
# generated by Terraform into Secrets Manager (tenure-pilot/dev-login); read it
# with:  aws secretsmanager get-secret-value --secret-id tenure-pilot/dev-login
DEV_LOGIN_PASSPHRASE=local-dev-passphrase

# Real sign-in. Setting all three switches the app to Okta; then AUTH_DEV_LOGIN
# can go to false and the acknowledgement above can be deleted.
OKTA_ISSUER=
OKTA_CLIENT_ID=
OKTA_CLIENT_SECRET=

# ── Optional ──────────────────────────────────────────────────────────────────

# Bearer token for POST /api/jobs/reminders. Unset means that route refuses
# every request (503) and no deadline reminders send.
JOB_SECRET=local-job-secret

# Document upload is disabled when unset.
S3_DOCUMENTS_BUCKET=
AWS_REGION=us-east-1

# Enables generated answers on /search. Extractive fallback when unset.
ANTHROPIC_API_KEY=

# ── Bootstrap behaviour ───────────────────────────────────────────────────────

# Reference data (clubs, roster, deliverables, resources) at container start.
# Off unless set; seeding is reference-data management, not part of booting.
# SEED_ON_BOOT=true

# Demo login accounts. Defaults to on outside production, off inside it.
# SEED_DEMO_ACCOUNTS=true

# Skip the migration bootstrap entirely (scripts/db-bootstrap.mjs).
# SKIP_DB_BOOTSTRAP=true
