// Tenure — Institutional OS for student organizations
// Architecture principles:
//   1. Role SEATS are durable identities — people rotate, knowledge stays
//   2. Every business record resolves to a tenant boundary (institutionId)
//   3. Club-owned records also carry organizationId; cross-tenant queries denied by default
//   4. State transitions are append-only and immutable

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// ─── NextAuth required models ────────────────────────────────────────────────

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ─── Identity & Tenancy ───────────────────────────────────────────────────────

// The university or contracted school — top-level tenant boundary
model Institution {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  domain    String?  // e.g., "simon.rochester.edu" — used for verified email matching
  logoUrl   String?
  // IANA zone every instant is rendered in for this institution. Instants are
  // stored in UTC; this is the wall clock officers actually work against, so a
  // 6pm event reads as 6pm here and in the ICS feed alike. See src/lib/time.ts.
  timeZone  String   @default("America/New_York")
  /// Whether this cell may resolve the tenant for users. Written by the
  /// reconciler from the signed deployment manifest; ACTIVATING is the step
  /// that publishes one setting it true. Deliberately has NO default: a row
  /// created without deciding must fail, not quietly go on the air.
  serving   Boolean
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organizations Organization[]
  memberships   InstitutionMembership[]
  auditEvents   AuditEvent[]
  deliverables  Deliverable[]
  roleTransfers RoleTransfer[]
  approvalDelegations ApprovalDelegation[]
  resources     Resource[]
  outboxEvents  OutboxEvent[]
  inboxEvents   InboxEvent[]
  modelUsage    ModelUsageMeter[]
  connectionLaunchTokens ConnectionLaunchToken[]
}

enum InstitutionRole {
  OSE_DIRECTOR  // Full institution access, policy, override
  OSE_STAFF     // Review, comment, access club history
  OSE_ADVISOR   // Assigned clubs or all clubs; no policy changes
}

// User's role at the institution level (OSE access)
/// GE-040-001. Membership is effective-dated, not a row that exists or does not.
///
/// Revoking used to `delete` the row, while the notification it sent said "Your
/// past activity stays on record". The audit log recorded the revocation; the
/// membership fact did not survive it, so nothing could answer "was this person
/// a Director on 12 March" — which is exactly what an approval signed on 12
/// March raises, and it contradicts the product's own thesis.
///
/// Liveness is never read off `status` alone. `@tenure/identity`'s
/// `membershipLiveness` combines status with the window, because a membership
/// whose window has closed is not live however active it claims to be.
enum MembershipStatus {
  ACTIVE
  SUSPENDED
  REVOKED
}

model InstitutionMembership {
  id            String          @id @default(cuid())
  userId        String
  user          User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  institutionId String
  institution   Institution     @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  role          InstitutionRole
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  status         MembershipStatus @default(ACTIVE)
  /// Defaults to the row's creation for every membership that predates this
  /// column, which is true: they were effective from when they were granted.
  effectiveFrom  DateTime         @default(now())
  /// Null means open-ended. Set to the instant of revocation, never cleared.
  effectiveUntil DateTime?
  /// Required by the engine for anything that removes access. Nullable here
  /// because ACTIVE rows have no reason to carry one.
  statusReason   String?

  @@unique([userId, institutionId])
  @@index([institutionId, role])
  /// Reads that mean "who is a member now" filter on this.
  @@index([institutionId, status, effectiveUntil])
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  // Profile picture. `image` is what the UI renders (an external URL or the
  // /api/profile-image proxy path); `imageKey` is the S3 object key for
  // uploaded pictures, resolved to a signed URL by the proxy.
  image         String?
  imageKey      String?
  // WRK-030-006. The revocation counter for this user's calendar feed token.
  // A calendar client polls a subscription URL forever, so there is no moment a
  // token is "consumed" and single-use would break the only feature the token
  // has. Bumping this number is what invalidates every token already issued —
  // the honest analogue of already-consumed for a credential that is meant to
  // be replayed. `verifyCalendarToken` refuses a token whose embedded epoch is
  // not this one; `calendarTokenEpochFor` in src/lib/calendar-data.ts reads it.
  calendarTokenEpoch Int   @default(0)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts              Account[]
  sessions              Session[]
  institutionMembership InstitutionMembership[]
  roleAssignments       RoleAssignment[]
  roleTransfersFrom      RoleTransfer[] @relation("RoleTransferFrom")
  roleTransfersTo        RoleTransfer[] @relation("RoleTransferTo")
  roleTransfersInitiated RoleTransfer[] @relation("RoleTransferInitiator")
  delegationsGiven       ApprovalDelegation[] @relation("DelegationFrom")
  delegationsReceived    ApprovalDelegation[] @relation("DelegationTo")
  messagesSent          Message[]
  participants          Participant[]
  notifications         Notification[]
  notificationPrefs     NotificationPreference[]
  deliverableReminders  DeliverableReminder[]
  resourcesAuthored     Resource[] @relation("ResourceAuthor")
  connectionLaunchTokens ConnectionLaunchToken[]
}

// ─── Organizations & Role Seats ───────────────────────────────────────────────

// A student club or association — identity persists across academic years
model Organization {
  id            String      @id @default(cuid())
  institutionId String
  institution   Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  name          String
  // Official name minus the parenthetical acronym, for compact display
  shortName     String?
  acronym       String?
  slug          String      @unique
  description   String?
  // Roster annotation, e.g. "Board formed Fall 2026"
  rosterNote    String?
  // Club image. logoUrl is what the UI renders: either an external image URL
  // (pasted by an admin/leader) or the /api/org-image proxy path when the
  // image was uploaded to object storage. imageKey is the S3 object key for
  // uploaded images, resolved to a signed URL by the proxy.
  logoUrl       String?
  imageKey      String?
  status        OrgStatus   @default(ACTIVE)
  category      OrgCategory @default(PROFESSIONAL)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  advisors       OrganizationAdvisor[]
  roles          Role[]
  seats          Seat[]
  approvals      ApprovalRequest[]
  events         Event[]
  conversations  Conversation[]
  documents      Document[]
  budgets        Budget[]
  vendors        Vendor[]
  memoryRecords  MemoryRecord[]
  feedPosts      FeedPost[]
  collabInterests CollabInterest[]
  budgetLines    BudgetLine[]
  ledgerEntries  LedgerEntry[]
  fundsFlowConfigs PaymentsFundsFlowConfig[]

  @@index([institutionId, status])
}

enum OrgStatus {
  ACTIVE
  ARCHIVED
  PENDING
}

enum OrgCategory {
  COMMUNITY
  PROFESSIONAL
  ORGANIZATION
  SOCIAL
}

// A durable board seat — the role persists when the occupant changes
model Role {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String       // "President", "VP Finance & Operations", etc.
  description    String?
  scope          RoleScope    @default(FUNCTIONAL)
  /// GE-051-005. The authority this seat carries, as a role-template key from
  /// packages/authorization. Read instead of `name`: a regex over the title
  /// meant renaming a seat silently granted or removed spending authority.
  /// Defaults to the smallest bundle so a path that has not been taught about
  /// templates confers the least, not the most.
  templateKey    String       @default("unit.member")
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  // GE-050-002. The position identity moved to Seat. What is left here is what
  // authorization reads, so renaming a position no longer edits this row.
  seat          Seat?
  assignments   RoleAssignment[]
  memoryRecords MemoryRecord[]
  holdings      SeatHolding[]

  @@unique([organizationId, name])
  @@index([organizationId, scope])
  @@index([templateKey])
}

/// The durable organizational position, separate from the authority it carries.
///
/// GE-050-001 named this the platform's primary continuity primitive: work,
/// decisions, files and history attach to the position "without becoming the
/// personal property of an occupant". GE-050-002 is the database agreeing —
/// until then these four columns lived on `Role`, in the same row every
/// authorization check reads.
///
/// One seat per role today, which is what the backfill produced. A second seat
/// sharing a role is a real future case; lifting the unique constraint is a
/// deliberate migration rather than something that happens by accident.
model Seat {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  roleId         String       @unique
  role           Role         @relation(fields: [roleId], references: [id], onDelete: Cascade)

  /// Permanent position ID — the seat's identity outlives every holder.
  positionCode   String?      @unique
  /// Editorial note from the roster, e.g. "Interim oversee marketing and Comms"
  positionNote   String?
  /// Why a seat is empty, e.g. "Opening in the fall". Only meaningful when the
  /// seat has no current holder.
  vacancyNote    String?
  /// Preserves the seat order as published by OSE
  seatOrder      Int?

  /// Effective-dated: a position is created and can be retired. A retired seat
  /// is not deleted — its history stays answerable.
  effectiveFrom  DateTime     @default(now())
  effectiveUntil DateTime?
  retiredAt      DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  /// PAY-030-007. Entries POSTED from this seat. `postedById` is a bare user id
  /// that means nothing once the person graduates; the seat outlives them.
  ledgerEntriesPosted     LedgerEntry[] @relation("LedgerEntryPostedBySeat")
  /// PAY-080-004. Entries ATTRIBUTED to this seat — a different question from
  /// who typed it in.
  ledgerEntriesAttributed LedgerEntry[] @relation("LedgerEntryAttributedSeat")

  @@index([organizationId])
}

/// An institution-wide club deadline: audits, evaluations, event submission
/// windows, transition milestones, trainings.
///
/// Separate from Event because these are published by OSE for every club at
/// once, rather than being one club's activity. `key` is a stable identifier
/// from the source document so re-seeding updates rather than duplicates.
model Deliverable {
  id            String          @id @default(cuid())
  institutionId String
  institution   Institution     @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  key           String          @unique
  title         String
  description   String?
  dueAt         DateTime
  /// FALL_A | FALL_B | SPRING_A | SPRING_B — null outside the mini-mesters
  /// (a December audit falls over winter break and is still due)
  term          String?
  /// Which board seat owns it, matching SeatKey in src/lib/resources.ts
  seat          String          @default("ALL")
  kind          DeliverableKind @default(DEADLINE)
  /// Which OSE document this came from, so the rule is auditable
  source        String?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  reminders DeliverableReminder[]

  @@index([institutionId, dueAt])
  @@index([seat, dueAt])
}

enum DeliverableKind {
  DEADLINE
  WINDOW
  TRAINING
  MEETING
}

/// Records that a person was reminded about a deliverable, so the 24-hour
/// warning fires exactly once per person.
model DeliverableReminder {
  id            String      @id @default(cuid())
  deliverableId String
  deliverable   Deliverable @relation(fields: [deliverableId], references: [id], onDelete: Cascade)
  userId        String
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  sentAt        DateTime    @default(now())

  @@unique([deliverableId, userId])
  @@index([userId])
}

/// A person from the OSE roster — board member or club advisor.
///
/// Deliberately NOT a User. Seeding the real roster as login accounts would
/// let anyone with the URL impersonate a real student while dev sign-in is
/// enabled. These records are directory data: displayed, searchable, and
/// emailable, but they cannot be signed in as. When Okta lands, real people
/// authenticate there and are matched to these records by email.
model DirectoryPerson {
  id          String        @id @default(cuid())
  name        String
  email       String        @unique
  kind        DirectoryKind @default(STUDENT)
  // For advisors: "Ainslie OSE", "Benet Center", "Faculty", ...
  affiliation String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  holdings   SeatHolding[]
  advisorFor OrganizationAdvisor[]

  @@index([kind])
}

enum DirectoryKind {
  STUDENT
  ADVISOR
}

/// Who holds (or held) a seat in a given academic year.
///
/// Past terms are kept rather than overwritten: "who had this job last year
/// and how do I reach them" is the core handoff question Tenure exists to
/// answer.
model SeatHolding {
  id        String          @id @default(cuid())
  roleId    String
  role      Role            @relation(fields: [roleId], references: [id], onDelete: Cascade)
  personId  String
  person    DirectoryPerson @relation(fields: [personId], references: [id], onDelete: Cascade)
  term      String          // "2026-2027"
  isCurrent Boolean         @default(true)
  createdAt DateTime        @default(now())

  @@unique([roleId, personId, term])
  @@index([roleId, isCurrent])
  @@index([personId])
}

/// Club advisors, with the contact details every board member needs on hand.
model OrganizationAdvisor {
  organizationId String
  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  personId       String
  person         DirectoryPerson @relation(fields: [personId], references: [id], onDelete: Cascade)
  createdAt      DateTime        @default(now())

  @@id([organizationId, personId])
  @@index([personId])
}

enum RoleScope {
  PRESIDENT   // Club admin — approves VP requests, escalates to OSE
  FUNCTIONAL  // VP/Chair — scoped to their domain
  MEMBER      // General member — limited visibility
}

// Time-bounded link between a person and a role seat
enum AssignmentStatus {
  SHADOW  // Incoming: read-only access before term begins
  ACTIVE  // Current role holder
  ALUMNI  // Past holder — record preserved, access revoked
}

model RoleAssignment {
  id        String           @id @default(cuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  roleId    String
  role      Role             @relation(fields: [roleId], references: [id], onDelete: Cascade)
  status    AssignmentStatus @default(ACTIVE)
  startDate DateTime         @default(now())
  endDate   DateTime?
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  @@index([userId, roleId])
  @@index([roleId, status])
}

// ─── Approval Workflow ────────────────────────────────────────────────────────

enum ApprovalType {
  EVENT          // Event proposal
  BUDGET         // Budget or spend request
  VENDOR         // Vendor engagement or contract
  COMMUNICATION  // External communication or press
  DOCUMENT       // Policy or formal document
  EXCEPTION      // Policy exception or override request
  ROSTER         // Membership or role change
}

enum ApprovalStatus {
  DRAFT
  PENDING_PRESIDENT
  NEEDS_CHANGES
  PENDING_OSE
  APPROVED
  REJECTED
  CANCELLED
}

// Every request is a durable record — not an email thread
model ApprovalRequest {
  id             String         @id @default(cuid())
  institutionId  String
  organizationId String
  organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  type           ApprovalType
  title          String
  description    String?
  status         ApprovalStatus @default(DRAFT)
  submittedById  String
  /// Who PREPARED this request, when that is somebody other than the person who
  /// submitted it. Maker-checker (`SAME_MAKER` in @tenure/authorization) needs a
  /// name to refuse: without it a drafter who handed the request to a colleague
  /// to submit was still offered the gate on their own work. Null means the
  /// submitter prepared it, and `decisionControl` then falls through to the
  /// SELF_APPROVAL arm, which already covers that case.
  preparedById   String?
  metadata       Json           @default("{}") // type-specific fields
  /// REVIEW-FINDINGS #7. A CLIENT-supplied key, and therefore never globally
  /// unique: it used to be `@unique`, one index across every tenant, so tenant
  /// B's retry of "req-1" resolved onto tenant A's approval. It is scoped by
  /// `@@unique([institutionId, idempotencyKey])` below. PostgreSQL treats NULLs
  /// as distinct in a unique index, so the un-keyed rows stay free.
  idempotencyKey String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  steps         ApprovalStep[]
  conversation  Conversation?  @relation("ApprovalConversation")
  event         Event?         @relation("ApprovalEvent")
  ledgerEntries LedgerEntry[]
  /// PAY-070-003. The funds-flow configurations this EXCEPTION authorised.
  fundsFlowExceptions PaymentsFundsFlowConfig[] @relation("FundsFlowLiabilityException")

  @@unique([institutionId, idempotencyKey])
  @@index([organizationId, status])
  @@index([institutionId, status])
}

// Each gate in the approval state machine — append-only
//
// "Append-only" is enforced, not asserted: "ApprovalStep" is in
// APPEND_ONLY_MODELS (src/lib/audit-append-only.ts), so the Prisma extension
// refuses update / delete / upsert on it. Until that landed the comment on this
// model was simply false.
model ApprovalStep {
  id               String         @id @default(cuid())
  approvalId       String
  approval         ApprovalRequest @relation(fields: [approvalId], references: [id], onDelete: Cascade)
  fromStatus       ApprovalStatus
  toStatus         ApprovalStatus
  actorId          String
  actorRoleContext String?        // role seat name at time of decision
  reason           String?
  policySnapshot   Json           @default("{}") // permissions in effect at decision time
  /// PAY-030-005. The configuration REVISION this decision was made against —
  /// `<blueprintId>@<version>`, from configSnapshotForInstitution. Required, and
  /// deliberately not nullable: a transition history that cannot say which
  /// policy was in force answers "was this allowed at the time" with a shrug.
  configRevision   String
  /// The checksum of the resolved values, from the same snapshot. Different
  /// fact from the revision: two tenants on the same blueprint version can
  /// resolve to different values, and the same values can survive a version bump.
  configChecksum   String
  /// The capability/gate that conferred this decision, e.g. "approvals.gate.ose".
  /// Recorded so the trail names the AUTHORITY, not only the actor.
  authority        String
  /// Evidence backing the decision — the receipt, the signed contract.
  evidenceDocumentId String?
  evidenceDocument   Document?    @relation("ApprovalStepEvidence", fields: [evidenceDocumentId], references: [id])
  occurredAt       DateTime       @default(now())

  @@index([approvalId])
}

/// PAY-150-003. A standing declared interest, as `ConflictDeclaration` in
/// @tenure/authorization models it. Declared, not detected: the platform cannot
/// know an approver's partner works for the vendor, but it can make the
/// declaration binding once made. Loaded into the ControlWorld by
/// `standingDeclarationsFor` (src/lib/approvals-world.ts).
model ConflictDeclaration {
  id             String    @id @default(cuid())
  institutionId  String
  principalId    String
  /// What the interest is IN — a vendor id, an organization id, a person.
  subjectId      String
  /// Required. A conflict nobody can describe is one nobody can review.
  reason         String
  declaredAt     DateTime  @default(now())
  effectiveFrom  DateTime  @default(now())
  /// Null means open-ended.
  effectiveUntil DateTime?

  @@index([institutionId, principalId])
  @@index([institutionId, subjectId])
}

/// PAY-150-003. Standing down from ONE decision, as `Recusal` in
/// @tenure/authorization models it. Separate from a declaration on purpose: a
/// declared interest is a fact about a person, a recusal is an act about a
/// decision.
model Recusal {
  id             String    @id @default(cuid())
  institutionId  String
  principalId    String
  resourceType   String    @default("ApprovalRequest")
  resourceId     String
  reason         String
  declaredAt     DateTime  @default(now())
  effectiveFrom  DateTime  @default(now())
  /// Null means it never lapses. A recusal whose window has closed is loaded
  /// but not applied — the loader filters, `mayDecide` only checks membership.
  effectiveUntil DateTime?

  @@unique([institutionId, principalId, resourceId])
  @@index([institutionId, resourceId])
}

// ─── Calendar & Events ────────────────────────────────────────────────────────

enum EventStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  PUBLISHED
  CANCELLED
}

enum EventAudience {
  BOARD_ONLY
  CLUB_MEMBERS
  SCHOOL_WIDE
  INVITE_ONLY
  PUBLIC
}

model Event {
  id               String        @id @default(cuid())
  institutionId    String
  organizationId   String
  organization     Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  ownerRoleId      String?
  approvalId       String?       @unique
  approval         ApprovalRequest? @relation("ApprovalEvent", fields: [approvalId], references: [id])
  title            String
  description      String?
  startAt          DateTime
  endAt            DateTime
  timezone         String        @default("America/New_York")
  venue            String?
  capacity         Int?
  audience         EventAudience @default(CLUB_MEMBERS)
  status           EventStatus   @default(DRAFT)
  recurrenceRule   String?       // RFC 5545 RRULE
  conflictSummary  Json?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  conflicts ConflictRecord[]
  feedPosts FeedPost[]
  /// PAY-080-004. Money attributed to this event.
  ledgerEntries LedgerEntry[]

  @@index([institutionId, startAt])
  @@index([organizationId, status])
}

enum ConflictSeverity {
  HARD        // Same room/time — block
  SOFT        // Audience collision — warn
  INFORMATIONAL
}

model ConflictRecord {
  id         String           @id @default(cuid())
  eventId    String
  event      Event            @relation(fields: [eventId], references: [id], onDelete: Cascade)
  conflictWithEventId String?
  severity   ConflictSeverity
  reason     String
  resolved   Boolean          @default(false)
  resolvedAt DateTime?
  createdAt  DateTime         @default(now())

  @@index([eventId])
}

// ─── Messaging & InMail ───────────────────────────────────────────────────────

enum ConversationType {
  DIRECT_MESSAGE   // VP <-> President, President <-> OSE, authorized peers
  BOARD_CHANNEL    // President and board inside one club
  APPROVAL_THREAD  // Immutable conversation attached to a request
  PRESIDENT_NETWORK // Cross-club coordination, governed by OSE
  OSE_BROADCAST    // Administration to everyone or selected audience
  SYSTEM           // Automated status, deadline, security messages
}

model Conversation {
  id              String           @id @default(cuid())
  institutionId   String
  organizationId  String?
  organization    Organization?    @relation(fields: [organizationId], references: [id])
  type            ConversationType
  approvalId      String?          @unique
  approval        ApprovalRequest? @relation("ApprovalConversation", fields: [approvalId], references: [id])
  subject         String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  participants Participant[]
  messages     Message[]

  @@index([institutionId])
  @@index([organizationId, type])
}

model Participant {
  id               String       @id @default(cuid())
  conversationId   String
  conversation     Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  userId           String
  user             User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  roleContext      String?      // role name at time of joining
  kind             String       @default("to") // "to" | "cc" | "bcc"
  joinedAt         DateTime     @default(now())
  lastReadMessageId String?

  deliveries Delivery[]

  @@unique([conversationId, userId])
}

// Messages are immutable — corrections are new entries linked via replyToId
model Message {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderId       String
  sender         User         @relation(fields: [senderId], references: [id])
  body           String       @db.Text
  format         String       @default("markdown") // "markdown" | "plain"
  replyToId      String?
  editedAt       DateTime?
  createdAt      DateTime     @default(now())

  attachments Attachment[]
  deliveries  Delivery[]

  @@index([conversationId, createdAt])
}

model Attachment {
  id          String   @id @default(cuid())
  messageId   String
  message     Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)
  fileName    String
  mimeType    String
  objectKey   String   // S3 key — never expose directly; use signed URLs
  sizeBytes   Int?
  checksum    String?
  sensitivity String   @default("standard")
  createdAt   DateTime @default(now())
}

model Delivery {
  id            String      @id @default(cuid())
  messageId     String
  message       Message     @relation(fields: [messageId], references: [id], onDelete: Cascade)
  participantId String
  participant   Participant @relation(fields: [participantId], references: [id], onDelete: Cascade)
  channel       String      // "in_app" | "email" | "push"
  deliveredAt   DateTime?
  readAt        DateTime?
  failureReason String?

  @@unique([messageId, participantId, channel])
}

// ─── Documents & Institutional Memory ────────────────────────────────────────

model Document {
  id             String       @id @default(cuid())
  institutionId  String
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  title          String
  description    String?
  objectKey      String       // S3 key
  mimeType       String
  sizeBytes      Int?
  version        Int          @default(1)
  sensitivity    String       @default("standard")
  createdById    String?
  isArchived     Boolean      @default(false)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  ledgerEntries  LedgerEntry[]
  approvalStepEvidence ApprovalStep[] @relation("ApprovalStepEvidence")

  @@index([organizationId, isArchived])
}

// A typed unit of preserved knowledge attached to a role seat
enum MemoryRecordType {
  CONTACT     // Sponsor, vendor, university contact
  PLAYBOOK    // Step-by-step guide for recurring events or tasks
  BUDGET      // Financial record or budget template
  VENDOR      // Vendor deal, contract, or relationship
  LESSON      // Hard-won insight for the successor
  THREAD      // Ongoing initiative or open question
  CREDENTIAL  // Login / access info — stored encrypted
  DEADLINE    // Compliance or recurring deadline
}

model MemoryRecord {
  id             String           @id @default(cuid())
  institutionId  String
  organizationId String
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  roleId         String?
  role           Role?            @relation(fields: [roleId], references: [id])
  title          String
  type           MemoryRecordType
  content        Json
  authorId       String?
  isArchived     Boolean          @default(false)
  sensitivity    String           @default("standard")
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  @@index([organizationId, type, isArchived])
  @@index([roleId])
}

// ─── Budget & Vendors ─────────────────────────────────────────────────────────

enum BudgetPeriod {
  FALL
  SPRING
  FULL_YEAR
}

model Budget {
  id             String       @id @default(cuid())
  institutionId  String
  organizationId String
  /// PAY-030-006. Restrict — see the note on LedgerEntry.organization.
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  period         BudgetPeriod
  academicYear   String       // e.g., "2025-26"
  totalCents     Int          @default(0)
  allocatedCents Int          @default(0)
  currency       String       @default("USD")
  notes          String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  transactions Transaction[]

  @@unique([organizationId, period, academicYear])
}

enum TransactionType {
  ALLOCATION   // Funds allocated to this budget
  SPEND        // Approved expense
  REIMBURSEMENT
  ADJUSTMENT
}

model Transaction {
  id          String          @id @default(cuid())
  budgetId    String
  /// PAY-030-006. Restrict — deleting a budget must not silently take its
  /// posted transactions with it.
  budget      Budget          @relation(fields: [budgetId], references: [id], onDelete: Restrict)
  type        TransactionType
  amountCents Int
  description String
  approvalId  String?
  recordedById String?
  occurredAt  DateTime        @default(now())
  createdAt   DateTime        @default(now())

  @@index([budgetId, occurredAt])
}

/// A category line in a club's budget — the unit the finance dashboard plots.
///
/// Budgeted vs actual per category is how a VP of Finance already tracks in a
/// spreadsheet, so this is what an uploaded Excel maps onto and what the
/// actual-vs-budget chart reads. `forecastCents` holds a saved projection
/// (null = none), keeping a what-if separate from the real actual.
model BudgetLine {
  id             String       @id @default(cuid())
  organizationId String
  /// PAY-030-006. Restrict — see the note on LedgerEntry.organization.
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  academicYear   String       // "2026-2027"
  category       String
  budgetedCents  Int          @default(0)
  actualCents    Int          @default(0)
  /// Saved forecast projection for cost-savings planning; null when unset
  forecastCents  Int?
  currency       String       @default("USD")
  note           String?
  sortOrder      Int          @default(0)
  /// "manual" | "import" — where the line came from
  source         String       @default("manual")
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  ledgerEntries  LedgerEntry[]

  @@unique([organizationId, academicYear, category])
  @@index([organizationId, academicYear])
}

model Vendor {
  id             String       @id @default(cuid())
  institutionId  String
  organizationId String
  /// PAY-030-006. Restrict — see the note on LedgerEntry.organization.
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  name           String
  contactName    String?
  contactEmail   String?
  contactPhone   String?
  website        String?
  notes          String?
  isArchived     Boolean      @default(false)
  createdById    String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  ledgerEntries  LedgerEntry[]

  @@index([organizationId, isArchived])
}

/// PAY-130-002. Which side of the journal a row is.
///
/// The direction lives here and the magnitude lives in `amountCents`, which is
/// debit-positive — so `Σ amountCents` over one `journalId` is exactly zero for
/// a balanced journal, and a non-zero sum is a broken one that a query can find.
enum LedgerSide {
  DEBIT
  CREDIT
}

enum LedgerKind {
  SPEND         // an expense posted against the line (increases actual spend)
  REIMBURSEMENT // money recovered (decreases actual spend)
  ADJUSTMENT    // a signed correction
  /// PAY-230-004. Money coming IN — dues, an event ticket, a sponsorship.
  /// Every other kind is outbound, so before this the platform could not post a
  /// receipt at all, let alone allocate one across a club, a fund and an event.
  RECEIPT
  /// PAY-120-001. The correction of a posted entry, as an opposite entry.
  /// Before this the only correction path was `ledgerEntry.delete()`: the row
  /// was erased, the line's actual was recomputed from the survivors, and
  /// nothing recorded that the money had ever been recognised or why it stopped
  /// being. A reversal states the amount, the reason and the entry it answers,
  /// and both rows survive.
  REVERSAL
}

/// A posted ledger entry against a budget line — the transaction detail behind a
/// line's "actual". Every entry can point at its SOURCE (the approved request,
/// the vendor, the receipt document), so any actual figure drills down to the
/// records that justify it. A line's actualCents is the cache of Σ amountCents.
model LedgerEntry {
  id             String           @id @default(cuid())
  /// PAY-030-007. The tenant boundary, on the row. It used to be reachable only
  /// by joining Organization, so "every posting in this institution" was a join
  /// and an entry could not be filtered to its tenant at all without one.
  institutionId  String
  organizationId String
  /// PAY-030-006. Restrict, not Cascade. One organization.delete() used to
  /// destroy the posted ledger the finance dashboard reports and the approval
  /// engine writes. An org is ARCHIVED (OrgStatus.ARCHIVED), never deleted out
  /// from under its financial history.
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  /// PAY-130-002. Nullable, because only ONE side of a journal carries the
  /// budget-line dimension. A club's expense hits a budget line; the payable to
  /// the member who fronted the cash is an organization-level liability and
  /// does not. Dimensioning both halves would double the line's actual and,
  /// once the signs are taken into account, drive `Σ amountCents` to zero.
  ///
  /// Nullable rather than a `budgetDimensioned` flag on purpose: every
  /// `aggregate({ where: { budgetLineId } })` in the app already excludes NULL
  /// automatically, so the line's actual stays correct without every call site
  /// having to learn about journals. A boolean would have made three existing
  /// aggregates silently wrong.
  budgetLineId   String?
  budgetLine     BudgetLine?      @relation(fields: [budgetLineId], references: [id], onDelete: Restrict)
  academicYear   String
  // ── PAY-130-002: double entry ──────────────────────────────────────────────
  /// The journal this row is one side of. Both halves of a posting share it, so
  /// a reader can find the other side — which, before this, did not exist.
  journalId      String
  /// The posting template that produced the journal, at the revision that was
  /// effective when it posted. Kept on the row because the template is
  /// effective-dated: knowing WHICH revision posted a March entry is the only
  /// way to re-derive it later.
  templateId     String
  /// Chart-of-accounts code this side hits.
  account        String
  side           LedgerSide
  /// When the entry takes effect in the books, which is not when it was
  /// written. `occurredAt` is when the spend happened and `createdAt` is when
  /// the row was inserted; neither is the accounting date, and a late-posted
  /// correction needs all three to be different.
  effectiveAt    DateTime         @default(now())
  kind           LedgerKind       @default(SPEND)
  /// Signed effect on actual spend, in cents (SPEND +, REIMBURSEMENT/RECEIPT −).
  amountCents    Int
  /// PAY-080-004. The currency `amountCents` is counted in. Its parent
  /// BudgetLine has carried one since it existed; the entry did not, so the
  /// amount was an untagged integer whose denomination had to be inferred by a
  /// join — the exact failure @tenure/finops' Money type exists to prevent.
  /// Backfilled from the line, then NOT NULL.
  currency       String
  description    String
  memo           String?
  occurredAt     DateTime         @default(now())
  // Summary-to-source links.
  approvalId     String?
  approval       ApprovalRequest? @relation(fields: [approvalId], references: [id])
  vendorId       String?
  vendor         Vendor?          @relation(fields: [vendorId], references: [id])
  documentId     String?
  document       Document?        @relation(fields: [documentId], references: [id])
  postedById     String?
  /// PAY-030-007. The durable owner SEAT that posted this, alongside the raw
  /// user id. People rotate; the seat is what still answers "whose posting was
  /// this" next year.
  postedBySeatId String?
  postedBySeat   Seat?            @relation("LedgerEntryPostedBySeat", fields: [postedBySeatId], references: [id])
  // ── PAY-080-004: attribution that must survive provider settlement ─────────
  /// Which event this money belongs to.
  eventId        String?
  event          Event?           @relation(fields: [eventId], references: [id])
  /// Which seat it is attributed to — not necessarily the one that posted it.
  seatId         String?
  seat           Seat?            @relation("LedgerEntryAttributedSeat", fields: [seatId], references: [id])
  /// The fund dimension. A code rather than a table: there is no Fund model to
  /// point at yet, and a dangling FK is worse than an honest string.
  fundCode       String?
  /// The provider settlement this entry was reconciled through, when it came in
  /// through one. Nullable: most entries are posted by hand and settle nowhere.
  settlementId   String?
  settlement     Settlement?      @relation(fields: [settlementId], references: [id])
  // ── PAY-120-001: the refund / reversal chain ───────────────────────────────
  /// The entry this one reverses. Set only on a REVERSAL, and `@unique` so one
  /// posting can be answered at most once — a second reversal would double the
  /// correction and leave the line short by the amount it was meant to restore.
  /// Restrict, like every other link into a posted entry: the record a
  /// correction refers to must not be removable out from under it.
  reversesId     String?          @unique
  reverses       LedgerEntry?     @relation("LedgerReversal", fields: [reversesId], references: [id], onDelete: Restrict)
  reversedBy     LedgerEntry?     @relation("LedgerReversal")
  /// Why the correction was made, in the words of whoever made it. Required by
  /// `reverseLedgerEntry` — a reversal with no reason is a deletion with extra
  /// steps, and the reason is the only part of the pair a reader cannot infer.
  reversalReason String?
  createdAt      DateTime         @default(now())

  allocations    ReceiptAllocation[]

  @@index([budgetLineId, occurredAt])
  @@index([organizationId, academicYear])
  @@index([institutionId, occurredAt])
  @@index([organizationId, eventId])
  @@index([organizationId, seatId])
  @@index([organizationId, fundCode])
  @@index([settlementId])
  /// PAY-130-002. Both halves of a posting share a journalId, so finding the
  /// other side — and checking that a journal sums to zero — is an index seek.
  @@index([journalId])
}

// ─── Receipts, settlement and provider references ─────────────────────────────

/// PAY-230-004. Where an inbound receipt came from.
enum ReceiptSource {
  DUES
  EVENT
  SPONSORSHIP
}

/// PAY-230-004. One slice of a RECEIPT entry, attributed to a club / fund /
/// event. A dues payment collected once and shared three ways is three rows
/// here summing to exactly the receipt — split by `allocateReceipt`
/// (packages/finops/src/allocation.ts), which uses the largest-remainder method
/// so the parts add back to the whole instead of each rounding independently.
model ReceiptAllocation {
  id             String        @id @default(cuid())
  institutionId  String
  ledgerEntryId  String
  ledgerEntry    LedgerEntry   @relation(fields: [ledgerEntryId], references: [id], onDelete: Restrict)
  source         ReceiptSource
  /// The club this slice belongs to. Not necessarily the entry's own org — a
  /// sponsorship banked by one club can be shared with a co-host.
  organizationId String
  fundCode       String?
  eventId        String?
  /// Positive minor units. The slice, not the whole receipt.
  minorUnits     Int
  currency       String
  createdAt      DateTime      @default(now())

  @@index([institutionId, ledgerEntryId])
  @@index([organizationId, source])
}

/// PAY-020-004 / PAY-130-004. The provider-neutral id table.
///
/// Bible §5: "A raw stripe_customer_id without account context is not globally
/// unique enough." `cus_123` in test mode and `cus_123` in live mode are
/// different objects, and the same id under two connected accounts is two
/// objects again. So the external key is qualified by (provider, mode,
/// connected account, object type) and the id Tenure owns — `canonicalId` — is
/// the one every other row points at. The provider's id is never a primary key.
model ExternalReference {
  id                 String   @id @default(cuid())
  institutionId      String
  /// "stripe" | "adyen" | ... — never assumed.
  provider           String
  /// "test" | "live". Dropping this from the key merges a sandbox object onto a
  /// real one, which is a silently wrong reconciliation rather than an error.
  mode               String
  /// The provider PROGRAM (platform account / merchant program), when there is one.
  programId          String?
  /// The connected/merchant account the id is scoped to.
  connectedAccountId String
  /// "customer" | "payment_intent" | "balance_transaction" | ...
  objectType         String
  externalId         String
  /// Tenure's own id for the thing. Owned here, stable across providers.
  canonicalId        String
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  settlements Settlement[]

  @@unique([provider, mode, connectedAccountId, objectType, externalId])
  @@unique([institutionId, canonicalId])
  @@index([institutionId, provider, mode])
}

/// PAY-080-004. A provider payout, so club / fund / event / seat attribution
/// survives the hop through settlement instead of being reconstructed from a
/// bank statement afterwards.
model Settlement {
  id                  String             @id @default(cuid())
  institutionId       String
  externalReferenceId String?
  externalReference   ExternalReference? @relation(fields: [externalReferenceId], references: [id])
  occurredAt          DateTime
  currency            String
  grossMinorUnits     Int
  feeMinorUnits       Int
  netMinorUnits       Int
  createdAt           DateTime           @default(now())

  ledgerEntries LedgerEntry[]

  @@index([institutionId, occurredAt])
}

/// PAY-130-004. An ingested provider balance transaction.
///
/// The unique tuple IS the point. `txn_123` in test and `txn_123` in live are
/// different objects; so is the same id under two provider accounts. Keying on
/// `externalId` alone reports the second as a replay of the first and silently
/// drops a real transaction. `payloadDigest` is what makes a replay checkable:
/// same id and same digest is a retry, same id and a DIFFERENT digest is a
/// conflict somebody has to look at, never an idempotent no-op.
model ProviderBalanceTransaction {
  id                String   @id @default(cuid())
  institutionId     String
  provider          String
  mode              String
  providerAccountId String
  externalId        String
  payloadDigest     String
  currency          String
  grossMinorUnits   Int
  feeMinorUnits     Int
  netMinorUnits     Int
  occurredAt        DateTime
  ingestedAt        DateTime @default(now())

  @@unique([provider, mode, providerAccountId, externalId])
  @@index([institutionId, ingestedAt])
}

/// PAY-140-008. The minimized, immutable receipt for one inbound provider event.
///
/// Written BEFORE any processing (Bible §16: "Persist a minimized immutable
/// receipt before asynchronous processing"), and it is what `dedupe` reads.
/// The unique tuple is `(provider, mode, accountId, eventId)` for the reason
/// `ProviderBalanceTransaction` states about its own: `evt_1` in test and in
/// live are different events, and so is the same id under two connected
/// accounts.
///
/// `sequence` is the provider's ordering signal. Reordering is normal at the
/// transport layer; applying an older account state on top of a newer one is
/// not, and without a stored sequence there is nothing to compare against.
///
/// No payload column. Bible §16 minimizes provider payloads and PAY-020-006
/// keeps them out of general storage; what is kept is what dedupe, ordering and
/// support need.
model ProviderEventReceipt {
  id             String   @id @default(cuid())
  provider       String
  mode           String
  /// The connected account the event is about, or the platform account.
  accountId      String
  eventId        String
  eventType      String
  sequence       Int
  /// The API version the event declared, checked against the pinned one.
  apiVersion     String
  /// "new" | "duplicate" | "out-of-order" — what `dedupe` said on arrival.
  dedupeVerdict  String
  /// Which secret in the rotation window verified it. Names a rotation that has
  /// not finished: events still arriving on index 1 mean the old key is live.
  verifiedBySecretIndex Int
  receivedAt     DateTime @default(now())

  @@unique([provider, mode, accountId, eventId])
  @@index([provider, mode, accountId, sequence])
}

/// PAY-070-003. The funds flow one tenant merchant is configured for.
///
/// The row exists so the liability gate has something to refuse. A
/// liability-shifting flow — DESTINATION or SEPARATE_CHARGE_AND_TRANSFER with
/// Tenure carrying loss — may only be written when an APPROVED
/// `ApprovalType.EXCEPTION` request exists whose pinned decision digest equals
/// the digest of the decision being written. `exceptionApprovalId` and
/// `decisionDigest` record which approval authorised THIS configuration, so a
/// later edit that changes the amounts produces a different digest and needs a
/// new approval rather than inheriting the old one's authority.
model PaymentsFundsFlowConfig {
  id                  String           @id @default(cuid())
  institutionId       String
  organizationId      String
  organization        Organization     @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  /// The seller legal entity this configuration is for.
  legalEntityId       String
  capabilityId        String
  /// "DIRECT" | "DESTINATION" | "SEPARATE_CHARGE_AND_TRANSFER".
  chargeModel         String
  /// "TENURE" | "TENANT" | "PROVIDER" | "CUSTOMER".
  liableParty         String
  region              String
  currency            String
  grossCents          Int
  platformFeeCents    Int
  /// sha256 of the decision this row was written from.
  decisionDigest      String
  exceptionApprovalId String?
  exceptionApproval   ApprovalRequest? @relation("FundsFlowLiabilityException", fields: [exceptionApprovalId], references: [id], onDelete: Restrict)
  createdById         String
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt

  @@unique([organizationId, legalEntityId, capabilityId])
  @@index([institutionId, updatedAt])
}

// ─── Notifications ────────────────────────────────────────────────────────────

enum NotificationChannel {
  IN_APP
  EMAIL
  EMAIL_DIGEST
}

// ─── Community Feed ───────────────────────────────────────────────────────────
// Clubs post collaboration calls; other clubs raise interest; the OSE
// Director sits in the middle and approves each collaboration.

model FeedPost {
  id             String       @id @default(cuid())
  institutionId  String
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  authorId       String
  title          String
  body           String       @db.Text
  eventId        String?
  event          Event?       @relation(fields: [eventId], references: [id])
  isArchived     Boolean      @default(false)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  comments  FeedComment[]
  interests CollabInterest[]

  @@index([institutionId, createdAt])
}

model FeedComment {
  id        String   @id @default(cuid())
  postId    String
  post      FeedPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  authorId  String
  body      String
  createdAt DateTime @default(now())

  @@index([postId, createdAt])
}

enum CollabStatus {
  PENDING_OSE
  APPROVED
  DECLINED
}

model CollabInterest {
  id             String       @id @default(cuid())
  postId         String
  post           FeedPost     @relation(fields: [postId], references: [id], onDelete: Cascade)
  organizationId String // the interested club
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  requestedById  String
  note           String?
  status         CollabStatus @default(PENDING_OSE)
  decidedById    String?
  decisionNote   String?
  decidedAt      DateTime?
  createdAt      DateTime     @default(now())

  @@unique([postId, organizationId]) // one request per club per post
  @@index([status])
}

// In-app notification — RBAC-aware by construction (created per user)
model Notification {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  body      String?
  href      String? // in-app destination
  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, readAt])
  @@index([userId, createdAt])
}

model NotificationPreference {
  id      String              @id @default(cuid())
  userId  String
  user    User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  channel NotificationChannel
  enabled Boolean             @default(true)
  updatedAt DateTime          @updatedAt

  @@unique([userId, channel])
}

// ─── Audit Log ────────────────────────────────────────────────────────────────

// Append-only, tamper-evident — never update or delete
model AuditEvent {
  id            String      @id @default(cuid())
  institutionId String
  institution   Institution @relation(fields: [institutionId], references: [id])
  actorId       String?
  actorRole     String?
  action        String      // e.g., "ApprovalRequest.StatusChanged"
  resourceType  String      // e.g., "ApprovalRequest"
  resourceId    String?
  organizationId String?
  outcome       String      // "ALLOW" | "DENY"
  reason        String?
  metadata      Json        @default("{}")
  traceId       String?
  /// PAY-000-007. Which money-mode the action happened in: "test" or "live".
  ///
  /// Evidence that cannot say which mode an action was in cannot separate test
  /// from live at all — one deployment serves both, and two rows for the same
  /// action in two tenants were previously byte-identical on this point. Written
  /// by recordAuditEvent() from the ambient TenantScope, which resolves it from
  /// the tenant's published configuration (platform.payments.mode).
  ///
  /// Defaults to "test" so every row that predates this column reads as the
  /// mode that claims the least: none of them were written by a payment path,
  /// and backfilling them as "live" would manufacture evidence.
  mode          String      @default("test")
  occurredAt    DateTime    @default(now())

  @@index([institutionId, occurredAt])
  @@index([actorId, occurredAt])
  @@index([resourceType, resourceId])
  /// "Show me everything that happened in live for this tenant" is the query an
  /// incident review opens with.
  @@index([institutionId, mode, occurredAt])
}

// ─── Institution role transfers ───────────────────────────────────────────────

// The two-party handoff of an OSE administration role (Director / Staff / Advisor).
// The outgoing holder KEEPS their role until the successor accepts, so coverage
// is never interrupted. On acceptance the grant + step-down happen atomically.
enum RoleTransferStatus {
  PENDING    // awaiting the successor's decision
  COMPLETED  // successor accepted; role handed over
  DECLINED   // successor declined
  CANCELLED  // initiator withdrew before it was decided
}

model RoleTransfer {
  id            String             @id @default(cuid())
  institutionId String
  institution   Institution        @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  // The person handing the role off — keeps it until COMPLETED.
  fromUserId    String
  fromUser      User               @relation("RoleTransferFrom", fields: [fromUserId], references: [id], onDelete: Cascade)
  // The successor who must accept.
  toUserId      String
  toUser        User               @relation("RoleTransferTo", fields: [toUserId], references: [id], onDelete: Cascade)
  // The institution role being transferred (e.g. OSE_DIRECTOR).
  role          InstitutionRole
  status        RoleTransferStatus @default(PENDING)
  note          String?
  // Where the initiator lands on completion. Null = fully revoke their access.
  stepDownRole  InstitutionRole?
  initiatedById String
  initiatedBy   User               @relation("RoleTransferInitiator", fields: [initiatedById], references: [id], onDelete: Cascade)
  createdAt     DateTime           @default(now())
  resolvedAt    DateTime?

  @@index([institutionId, status])
  @@index([toUserId, status])
}

/// A backup approver. While active (revokedAt null), `toUser` may act on the
/// approval gates `fromUser` could act on — covering officer gaps (breaks,
/// exams) so requests never stall. Every delegated action records "on behalf of"
/// on the append-only ApprovalStep, so the trail stays honest.
model ApprovalDelegation {
  id            String      @id @default(cuid())
  institutionId String
  institution   Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  fromUserId    String
  fromUser      User        @relation("DelegationFrom", fields: [fromUserId], references: [id], onDelete: Cascade)
  toUserId      String
  toUser        User        @relation("DelegationTo", fields: [toUserId], references: [id], onDelete: Cascade)
  note          String?
  createdAt     DateTime    @default(now())
  revokedAt     DateTime?

  @@index([toUserId, revokedAt])
  @@index([fromUserId, revokedAt])
  @@index([institutionId])
}

enum ResourceKind {
  FORM
  GUIDE
  POLICY
  TOOL
  CHECKLIST
}

/// A board resource — a form, guide, policy, tool or checklist, routed to the
/// board seats that need it.
///
/// These used to live in a hardcoded TypeScript array, which meant no one could
/// add one: not a club president, not OSE staff, not even the OSE Director who
/// owns the board-resource programme. Publishing a new form required a code
/// change and a deploy. They are records now, owned by the institution, so the
/// people accountable for the content can maintain it (see canManageResources
/// in src/lib/rbac.ts).
///
/// `key` is a stable identifier carried over from the original array so that
/// existing links, seeds and bookmarks keep resolving after the migration.
model Resource {
  id            String       @id @default(cuid())
  institutionId String
  institution   Institution  @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  key           String
  title         String
  description   String
  /// External URL, or an internal Tenure route
  href          String
  external      Boolean      @default(false)
  /// False while an internal page is still being built. Unready resources
  /// render inert — a listed-but-dead link is worse than an honest "not yet".
  ready         Boolean      @default(true)
  kind          ResourceKind
  /// Seat audiences, matching SeatKey in src/lib/resources.ts
  seats         String[]
  /// Hard rule surfaced next to the link, e.g. a lead time
  rule          String?
  /// Manual ordering within a seat group; ties break on title
  sortOrder     Int          @default(0)
  /// Soft delete — a retired resource stays auditable and restorable
  archivedAt    DateTime?
  createdById   String?
  createdBy     User?        @relation("ResourceAuthor", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  @@unique([institutionId, key])
  @@index([institutionId, archivedAt])
  @@index([institutionId, kind])
}

// ─── Transactional outbox ─────────────────────────────────────────────────────

/// An event written in the SAME transaction as the change that caused it.
///
/// The property this table exists for is one sentence: "the row changed" and
/// "the event exists" cannot disagree. Publishing to a queue after committing
/// leaves a window where the change happened and the event did not, and nothing
/// downstream ever learns about it; publishing before committing leaves the
/// opposite. Writing here inside the caller's transaction removes the window,
/// and delivery becomes a separate, retryable problem.
///
/// `attempts`, `lastError` and `deadLetteredAt` live on the record rather than
/// in a queue's private state, so "why was this never delivered" is answerable
/// from the same database that holds the change.
model OutboxEvent {
  id String @id @default(cuid())

  /// Scoped like every other tenant row — the isolation registry classifies it.
  institutionId String
  institution   Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)

  /// The event, validated against the DomainEvent contract before dispatch.
  eventId       String @unique
  type          String
  schemaVersion Int
  resourceType  String
  resourceId    String
  correlationId String
  causationId   String?
  payload       Json   @default("{}")

  /// PAY-020-006. tenure | provider — who authored `payload`.
  ///
  /// Stored rather than inferred, because the dispatcher rehydrates the event
  /// from this row and `DomainEvent.origin` is required: an event that came
  /// back from the database without it would fail the contract at delivery
  /// time, a long way from whoever wrote it. Existing rows are `tenure`, which
  /// is true — the only writer is `outboxEventRow` from the approvals action.
  origin String @default("tenure")

  /// pending | dispatching | dispatched | dead
  state          String    @default("pending")
  attempts       Int       @default(0)
  lastError      String?
  /// When this record becomes due. Retries move it forward with backoff.
  availableAt    DateTime  @default(now())
  /// When a consumer confirmed it. Set only after delivery returns.
  dispatchedAt   DateTime?
  deadLetteredAt DateTime?

  occurredAt DateTime @default(now())
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  /// The dispatcher's only query: due records, oldest first.
  @@index([state, availableAt])
  @@index([institutionId, state])
}

/// The other half of at-least-once: what has already been consumed.
///
/// The outbox chooses duplication over loss — a dispatcher that marks a record
/// dispatched before the consumer confirms can lose it, so it marks after, and
/// a crash between the two redelivers. That is only bounded if the consumer can
/// recognise a redelivery, and recognising one needs somewhere to have written
/// down that it happened. This is that somewhere.
///
/// Keyed by consumer as well as event: two consumers of the same event are two
/// independent pieces of work, and one having run says nothing about the other.
/// The row is written in the SAME transaction as the handler's own effects, so
/// "marked consumed" and "the work happened" cannot disagree — the mirror of
/// the property the outbox itself exists for.
model InboxEvent {
  id String @id @default(cuid())

  institutionId String
  institution   Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)

  /// `DomainEvent.eventId` — the outbox row's own id is deliberately not used,
  /// because a replayed record keeps its event id and must stay deduplicated.
  eventId String
  /// Which handler ran. `@tenure/modules` declares who may consume what.
  consumer String

  consumedAt DateTime @default(now())

  @@unique([institutionId, eventId, consumer])
  @@index([institutionId, consumedAt])
}

/// WRK-120-004 — what one model call cost, per tenant.
///
/// The vendor reports `usage.input_tokens` and `usage.output_tokens` on every
/// successful response. Before this table `apps/web/src/lib/ai.ts` parsed the
/// response with a cast that named only `content`, so those two numbers arrived
/// on the wire and were dropped: no tenant could be charged, and no budget could
/// be enforced, because nothing anywhere knew a call had happened.
///
/// One row per provider call, not a running total. A counter can only answer
/// "how much", and every question worth asking afterwards — which model, which
/// month, was it one runaway loop or steady use — needs the calls themselves.
/// The aggregate is a SUM over `[institutionId, period]`, which the index below
/// exists for.
///
/// `period` is stored rather than derived at read time for the same reason: the
/// budget is a calendar-month allowance, and a query that computed the month
/// from `occurredAt` in SQL could not use an index and would disagree with the
/// application's own UTC month boundary the first time a server ran in another
/// zone.
model ModelUsageMeter {
  id String @id @default(cuid())

  /// Scoped like every other tenant row; `src/lib/tenancy/registry.ts`
  /// classifies it TENANT_SCOPED. A meter readable across tenants would expose
  /// how much another institution uses the assistant, which is a usage profile.
  institutionId String
  institution   Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)

  /// The model id actually invoked, from the allowed-model catalog. Two models
  /// do not cost the same, so a meter that forgot which one ran cannot be
  /// priced later even though it was measured correctly.
  model String

  /// As reported by the vendor. Never estimated from string lengths — an
  /// estimate that disagreed with the invoice would be worse than no meter.
  inputTokens  Int
  outputTokens Int

  /// The UTC calendar month this call is billed into, as `YYYY-MM`.
  period String

  occurredAt DateTime @default(now())
  createdAt  DateTime @default(now())

  /// The budget query: this tenant's total for this period.
  @@index([institutionId, period])
}

/// WRK-030-002 — Bible §5.3's launch token, stored as a hash.
///
/// What this replaces: `MissingConnectionCard`'s `pendingIntent` prop, whose own
/// comment said "Never persisted anywhere — this is component state passed
/// straight back out". So "Kept for when this connects" survived exactly as long
/// as the React tree. A refresh, a sign-in redirect, or finishing the connect on
/// a phone and coming back to the laptop all lost the question the person had
/// just asked — which is the round trip §5.3 step 2 exists to survive.
///
/// ## Deliberately the opposite of the calendar feed token
///
/// `src/lib/calendar-sync.ts` mints a stateless HMAC that is stable per user and
/// meant to be replayed forever, because Outlook polls it. This one is stored,
/// single-use and short-lived, because it is handed to a person once and
/// redeemed once. They are both "tokens" and almost nothing else about them is
/// the same; a launch token modelled on the feed token would be a bearer
/// credential with a 180-day life sitting in a browser history.
///
/// ## The hash, not the token
///
/// `tokenHash` is `sha256(token)`. A database dump, a log of a slow query, or a
/// support engineer reading rows never yields a usable token — the same reason
/// `VerificationToken` in NextAuth's own schema is not the shape used here. The
/// value exists only in the URL the person was handed.
model ConnectionLaunchToken {
  id String @id @default(cuid())

  /// The tenant the opportunity was opened in. `src/lib/tenancy/registry.ts`
  /// classifies this TENANT_SCOPED: a token readable across tenants would let
  /// one institution enumerate what another's members are trying to connect,
  /// and — worse — redeeming across tenants would restore one tenant's intent
  /// inside another's scope.
  institutionId String
  institution   Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)

  /// Who it was minted for. §5.3 binds the token to the user, so a token that
  /// leaks is not redeemable by whoever holds it.
  userId String
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// The capability the person was blocked on, e.g. `ai.model`. The audience
  /// bind: a token minted for one capability cannot be redeemed against
  /// another's connect flow.
  capabilityKey String

  /// `sha256(token)`, hex. Unique so a collision is a constraint violation
  /// rather than two people sharing an opportunity.
  tokenHash String @unique

  /// A random value mixed into the token. Named separately from the hash
  /// because it is what makes two opportunities with identical fields produce
  /// different tokens — without it a token would be a function of its contents
  /// and therefore guessable from them.
  nonce String

  /// The person's own words — the question they asked the assistant.
  ///
  /// Stored here rather than carried in the redirect URL because §5.2 forbids
  /// raw prompt content in a redirect: a URL travels through browser history,
  /// the Referer header, server access logs and any proxy in between, and a
  /// student's question about a club's finances is not something to put in any
  /// of them.
  pendingIntent String? @db.Text

  /// Where in Tenure the person was sent, so the redemption surface can prove
  /// it is the one that was named rather than any page that got hold of a
  /// token.
  returnPath String

  expiresAt  DateTime
  /// Set exactly once, by the same statement that claims the row. Non-null is
  /// what ALREADY_CONSUMED means.
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  /// The sweep query for expired, unredeemed opportunities.
  @@index([institutionId, expiresAt])
  @@index([userId, capabilityKey])
}
