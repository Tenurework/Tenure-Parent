{
  "compilerOptions": {
    "target": "ES2017",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": ["./src/*"],
      "@tenure/configuration": ["../../packages/configuration/src/index.ts"],
      // TEST-ONLY. reconcile.itest.ts cross-checks that an artifact the engine
      // signs verifies with this cell's own, independent implementation. The
      // cell must not depend on the engine at runtime, and
      // tests/security/cell-independence.test.mjs fails the build if any
      // non-test file here imports it.
      "@tenure/provisioning": ["../../packages/provisioning/src/index.ts"],
      "@tenure/blueprints": ["../../blueprints/index.ts"],
      "@tenure/organization-model": ["../../packages/organization-model/src/index.ts"],
      "@tenure/module-runtime": ["../../packages/module-runtime/src/index.ts"],
      "@tenure/modules": ["../../modules/index.ts"],
      "@tenure/authorization": ["../../packages/authorization/src/index.ts"],
      "@tenure/releases": ["../../packages/releases/src/index.ts"],
      "@tenure/workflow": ["../../packages/workflow/src/index.ts"],
      "@tenure/audit": ["../../packages/audit/src/index.ts"],
      "@tenure/metadata": ["../../packages/metadata/src/index.ts"],
      "@tenure/platform-config": ["../../packages/platform-config/src/index.ts"],
      "@tenure/platform-config/money": ["../../packages/platform-config/src/money.ts"]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    "../../packages/*/src/**/*.ts",
    "../../blueprints/**/*.ts",
    "../../modules/**/*.ts"
  ],
  "exclude": ["node_modules"]
}
